exports.echo = (req, res) => {
  const data = req.body;

  if (!data || Object.keys(data).length === 0) {
    return res.status(400).json({
      success: false,
      message: "No JSON data provided",
    });
  }

  res.json({
    success: true,
    receivedData: data,
  });
};
